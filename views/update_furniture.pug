doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Edit Furniture
    link(rel="stylesheet" href="/css/update.css")
  body
    .overlay
      header.navbar
        .logo-container
          img.logo(src="/images/Mayondo_Wood_Furniture_Store_Logo.png")
          h1 Mayondo Wood & Furniture Ltd
        nav.nav-links
          a(href="/manager") Dashboard
          a(href="/registeredFurniture") Back
      main.container
        .card
          h2 Update Furniture
          form(action=`/registeredFurniture/${furniture._id}/update` method="POST" enctype="multipart/form-data")
            .form-group
              label(for="furnitureName") Name of Furniture
              input#furnitureName(type="text" name="furnitureName" value=furniture.furnitureName required)
            .form-group
              label(for="productPrice") Product Price (UGX)
              input#productPrice(type="number" name="productPrice" value=furniture.productPrice step="0.01")
            .form-group
              label(for="quantity") Quantity
              input#quantity(type="number" name="quantity" value=furniture.quantity)
            .form-group
              label(for="quality") Quality of Product
              select#quality(name='quality' required='')
                option(value='') Select Quality
                option(value='High') High
                option(value='Medium') Medium
                option(value='Low') Low
            .form-group
              label(for="date") Date
              input#date(type="date" name="date" value=(furniture.date ? furniture.date.toISOString().slice(0,10) : ''))
            .form-group
              label(for="image") Replace Image (optional)
              input#image(type="file" name="image" accept="image/*")
            button.btn(type="submit") Update Furniture
